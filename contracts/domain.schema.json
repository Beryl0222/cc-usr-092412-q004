{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "健康规划指标口径库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "DEFINITION_APPROVED",
        "OBSERVATION_SUBMITTED",
        "QUALITY_REVIEWED",
        "TARGET_ASSIGNED",
        "RELEASE_REVISED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "indicator_definition",
        "regional_observation",
        "target_commitment",
        "publication_release"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
