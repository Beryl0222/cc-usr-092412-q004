{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "健康规划指标口径库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "DEFINITION_REGISTERED",
        "DEFINITION_APPROVED",
        "CONVERSION_SCHEME_ADOPTED",
        "CONVERSION_CONFLICT_QUEUED",
        "CONVERSION_CONFLICT_RESOLVED",
        "SOURCE_REGISTERED",
        "SOURCE_EXPIRED",
        "OBSERVATION_SUBMITTED",
        "COMPUTATION_JOB_STARTED",
        "CANDIDATE_COMPUTED",
        "QUALITY_REVIEWED",
        "USAGE_APPROVED",
        "REVIEW_DEADLINE_PASSED",
        "RELEASE_FROZEN",
        "RELEASE_REVISED",
        "TARGET_ASSIGNED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "indicator_definition",
        "boundary_conversion",
        "data_source",
        "regional_observation",
        "candidate_series",
        "publication_release",
        "target_commitment"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
